{
  "name": "gallery",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "gen:api": "node ../../packages/ui/scripts/gen-api.mjs",
    "predev": "npm run gen:api",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "prebuild": "npm run gen:api",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run gen:api",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots"
  },
  "dependencies": {
    "@proshore/ui": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
