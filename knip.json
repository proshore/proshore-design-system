{
  "workspaces": {
    "apps/gallery": {
      "entry": [
        "e2e/*.spec.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "e2e/**/*.ts"
      ]
    },
    "packages/ui": {
      "entry": [
        "src/entry.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/discovery-example": {
      "entry": [
        "e2e/*.spec.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "e2e/**/*.ts"
      ]
    },
    "packages/auth": {
      "entry": [
        "src/index.ts",
        "test/*.test.ts",
        "examples/*.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    }
  },
  "ignoreDependencies": [
    "vite"
  ]
}
