{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "skipLibCheck": true, "isolatedModules": true,
    "allowImportingTsExtensions": true, "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true, "verbatimModuleSyntax": true, "types": ["node"]
  },
  "include": ["src", "test"]
}
