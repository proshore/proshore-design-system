{
  "name": "@proshore/ui",
  "version": "0.5.0",
  "private": true,
  "description": "Proshore design system: tokens, layout, patterns, charts, tables. Source package inside the monorepo; `npm run pack` builds the installable core tarball.",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/styles.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/styles.ts",
    "./tokens.json": "./tokens/tokens.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "tokens": "node scripts/export-tokens.mjs",
    "pack": "node scripts/pack.mjs",
    "export:design-system": "node scripts/export-design-system.mjs",
    "test:export": "node --test scripts/export-design-system.test.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@internationalized/date": "^3.8.0",
    "@tanstack/react-table": "^9.2.4",
    "@visx/axis": "^4.0.0",
    "@visx/grid": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "react-aria-components": "^1.21.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@^5.9.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
